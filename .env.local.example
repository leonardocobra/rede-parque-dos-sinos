NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
# URL base do site, usada no redirect do magic link (auth).
# Em produção: https://seu-dominio. Em dev pode omitir (usa window.location.origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# E-mails autorizados a acessar o painel interno /admin (separados por vírgula).
# Env do SERVIDOR (sem NEXT_PUBLIC) — nunca exposta ao cliente. Sem ela, ninguém é admin.
ADMIN_EMAILS=seu-email@exemplo.com

# Chave service_role do Supabase — SERVIDOR apenas, NUNCA exposta ao cliente.
# Ignora RLS. Usada pelo /admin e pelas Route Handlers de IA para gravar em
# tabelas de leitura fechada (eventos, ai_invocacoes).
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Chave da API da Anthropic — SERVIDOR apenas, NUNCA exposta ao cliente.
# Usada pelas Route Handlers do AI Native Lab (app/api/ai/**).
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui
